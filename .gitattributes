# Normaliza para LF no repositório. Com o core.autocrlf=true do Windows,
# os tipos abaixo com "eol=lf" explícito ficam LF também na working tree,
# seguindo o files.eol do projeto.
* text=auto

# Código do app
*.js   text eol=lf
*.jsx  text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.svg  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.sql  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.txt  text eol=lf
*.csv  text eol=lf
*.map  text eol=lf

# Config deste repo — LF explícito (senão o Windows grava CRLF)
.gitignore       text eol=lf
.gitattributes   text eol=lf
*.code-workspace text eol=lf
.env.example     text eol=lf

# Lockfile é JSON de texto — normaliza para evitar diff/conflito entre máquinas
package-lock.json text eol=lf

# Windows: CRLF obrigatório para shell do cmd
*.bat text eol=crlf
*.cmd text eol=crlf

# Binários
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.avif binary
*.ico  binary
*.svgz binary
*.pdf  binary
*.mp3  binary
*.mp4  binary
*.woff  binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.otf  binary
*.zip  binary
*.gz   binary