# Copie para .env.local e preencha. Nunca versione o .env.local.
# Guia: docs/supabase-e-vapid.md

# Supabase da Lojinha (ref modldgphwfzjarydzolx) — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Web Push — gerar com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@email.com

# Número da loja para o wa.me (com DDI/DDD, só dígitos). Vazio = só grava o pedido.
WHATSAPP_LOJA=

# Banco DEV em rede local, só para npm run db:dev:dry | db:dev | db:dev:list (postgresql://usuario:senha@host:porta/postgres?sslmode=disable)
DEV_DB_URL=
